{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "teamwork": {
      "type": "streamable-http",
      "url": "https://mcp.ai.teamwork.com",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "projects",
              "desk",
              "spaces",
              "chat"
            ]
          }
        }
      }
    }
  }
}
